# Straum as a systemd service: the release's binary at
# /usr/local/bin/straum, the spec at /etc/straum/spec.sql and the DSN in
# /etc/straum/dsn, handed over as a credential so it never sits in the
# environment. A user made for the service runs it, with no write access
# anywhere.
#
#   sudo install -m 644 straum.service /etc/systemd/system/
#   sudo systemctl daemon-reload
#   sudo systemctl enable --now straum
[Unit]
Description=Straum: declared aggregates over PostgreSQL, answered over HTTP
Documentation=https://janbjorge.github.io/straum/deploy.html
Wants=network-online.target
After=network-online.target
# No start limit: a server down for a while must not leave Straum off
# for good.
StartLimitIntervalSec=0

[Service]
Type=exec
ExecStart=/usr/local/bin/straum run /etc/straum/spec.sql --dsn-file ${CREDENTIALS_DIRECTORY}/dsn --listen 127.0.0.1:8080
LoadCredential=dsn:/etc/straum/dsn
# Straum exits 1 on any failure and keeps no state, so starting it again
# is the whole recovery; it loads every table from a new slot.
Restart=on-failure
RestartSec=10s
# Room for Straum's 10 s drain of the asks in flight.
TimeoutStopSec=20s
# Size it by the cells the spec keeps.
MemoryMax=1G

DynamicUser=yes
NoNewPrivileges=yes
CapabilityBoundingSet=
ProtectSystem=strict
ProtectHome=yes
PrivateTmp=yes
PrivateDevices=yes
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectKernelLogs=yes
ProtectControlGroups=yes
ProtectClock=yes
ProtectHostname=yes
ProtectProc=invisible
RestrictAddressFamilies=AF_INET AF_INET6 AF_UNIX
RestrictNamespaces=yes
RestrictRealtime=yes
RestrictSUIDSGID=yes
LockPersonality=yes
MemoryDenyWriteExecute=yes
SystemCallArchitectures=native
SystemCallFilter=@system-service
SystemCallFilter=~@privileged
UMask=0077

[Install]
WantedBy=multi-user.target
